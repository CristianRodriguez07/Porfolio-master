---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

import "@fontsource-variable/onest";

interface Props {
  title: string;
  description: string;
}

const { description, title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
<script>
  const translations: Record<string, string> = {
    "Disponible para trabajar": "Available for work",
    "Desarrollador Full Stack / Especializado en Process Mining.": "Full Stack Developer / Specialized in Process Mining.",
    "Soy Cristian Rodríguez, desarrollador full stack en Madrid. Me enfoco en construir productos claros, funcionales y con una identidad visual más cuidada.": "I am Cristian Rodríguez, a full stack developer based in Madrid. I focus on building clear, functional products with a thoughtful visual identity.",
    "Ver experiencia": "View experience",
    "Hablemos": "Let's talk",
    "Perfil": "Profile",
    "Desarrollador con foco en minería de procesos": "Developer focused on process mining",
    "España": "Spain",
    "Foco": "Focus",
    "UI limpia y rendimiento": "Clean UI and performance",
    "Automatizo procesos para mejorar eficiencia y reducir errores.": "I automate processes to improve efficiency and reduce errors.",
    "Sobre mí": "About me",
    "Soy un joven desarrollador con más de 2 años de experiencia en minería de procesos con Celonis. Trabajo con SQL y Python para automatizar y optimizar procesos, transformando datos en mejoras medibles de eficiencia y reduciendo errores operativos.": "I am a young developer with more than 2 years of experience in process mining with Celonis. I use SQL and Python to automate and optimize processes, turning data into measurable efficiency gains and reducing operational errors.",
    "Mi objetivo es contribuir de manera significativa a la innovación tecnológica, aplicando mis conocimientos y desarrollando habilidades que me permitan ser parte activa de los cambios y avances que están transformando el futuro.": "My goal is to make a meaningful contribution to technological innovation by applying my knowledge and developing skills that allow me to play an active role in the changes shaping the future.",
    "Mi experiencia": "My experience",
    "Experiencia laboral": "Work experience",
    "Formación": "Education",
    "Certificaciones": "Certifications",
    "Identificación y materialización de valor de negocio.": "Identifying and realizing business value.",
    "Evaluación de procesos y priorización de oportunidades.": "Process assessment and opportunity prioritization.",
    "Implementación técnica y configuración de la plataforma.": "Technical implementation and platform configuration.",
    "Diseño de soluciones de Process Intelligence.": "Designing Process Intelligence solutions.",
    "Automatización de tareas y flujos basados en insights.": "Automating tasks and insight-based flows.",
    "Creación y presentación de demos orientadas a negocio.": "Creating and presenting business-focused demos.",
    "Process Mining y datos": "Process Mining and data",
    "Desarrollador": "Development",
    "Skills de Process Mining y datos": "Process Mining and data skills",
    "Skills de desarrollo": "Development skills",
    "Postgrado en Desarrollo de Aplicaciones web // Blockchain - Cesur Plaza Elíptica": "Postgraduate Degree in Web Application Development // Blockchain - Cesur Plaza Elíptica",
    "He completado un Postgrado en Desarrollo de Aplicaciones web // Blockchain, donde aprendí a desarrollar aplicaciones web y a trabajar con tecnologías emergentes como Blockchain. Este postgrado me permitió profundizar en mis conocimientos de desarrollo y adquirir nuevas habilidades que me permiten afrontar nuevos retos en el ámbito de la tecnología.": "I completed a postgraduate degree in Web Application Development // Blockchain, where I learned to build web applications and work with emerging technologies such as Blockchain. This program deepened my development knowledge and gave me new skills to take on challenges in technology.",
    "Grado Superior en Desarrollo de Aplicaciones Multiplataforma - Cesur Plaza Elíptica": "Higher Degree in Multiplatform Application Development - Cesur Plaza Elíptica",
    "Durante mis estudios en Desarrollo de Aplicaciones Multiplataforma (DAM), adquirí una sólida base en el diseño y desarrollo de software para diversos dispositivos. Aprendí a programar en lenguajes como Java, Kotlin, HTML y CSS, enfocándome en el desarrollo de aplicaciones en entornos Android. También me especialicé en bases de datos, trabajando con MySQL para la gestión y manipulación de datos. Además, durante un breve periodo, aprendí los fundamentos de Python, ampliando mis capacidades en el ámbito del desarrollo.": "During my studies in Multiplatform Application Development, I built a strong foundation in software design and development for different devices. I learned Java, Kotlin, HTML, and CSS, focusing on Android application development. I also specialized in databases with MySQL and learned the fundamentals of Python, expanding my development skills.",
    "Ciencias tecnológicas | Bachillerato - IES GRAN CAPITÁN": "Technology Sciences | High School - IES GRAN CAPITÁN",
    "Estudios de Bachillerato en la modalidad de Ciencias Tecnológicas en el IES GRAN CAPITÁN, centrado en matemáticas, física, tecnología y fundamentos de programación.": "High school studies in Technology Sciences at IES GRAN CAPITÁN, focused on mathematics, physics, technology, and programming fundamentals.",
    "Inicio": "Home",
    "Experiencia": "Experience",
    "Contacto": "Contact",
    "Mi CV": "My resume",
    "Portfolio en evolución.": "Portfolio in progress.",
    ". Portfolio en evolución.": ". Portfolio in progress.",
    "Foto de Cristian Rodríguez": "Photo of Cristian Rodríguez",
    "Navegación principal": "Main navigation",
    "2025-Actualidad": "2025-Present",
  };

  const reverseTranslations = Object.fromEntries(
    Object.entries(translations).map(([spanish, english]) => [english, spanish]),
  );
  const languageToggle = document.querySelector<HTMLButtonElement>("[data-language-toggle]");
  let isEnglish = false;

  const translatePage = () => {
    const dictionary = isEnglish ? translations : reverseTranslations;
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    let node = walker.nextNode();

    while (node) {
      const text = node.textContent ?? "";
      const trimmedText = text.trim();
      const translatedText = dictionary[trimmedText];
      if (translatedText) node.textContent = text.replace(trimmedText, translatedText);
      node = walker.nextNode();
    }

    document.querySelectorAll<HTMLElement>("[aria-label]").forEach((element) => {
      const label = element.getAttribute("aria-label") ?? "";
      const translatedLabel = dictionary[label];
      if (translatedLabel) element.setAttribute("aria-label", translatedLabel);
    });
    document.querySelectorAll<HTMLElement>("[alt]").forEach((element) => {
      const alt = element.getAttribute("alt") ?? "";
      const translatedAlt = dictionary[alt];
      if (translatedAlt) element.setAttribute("alt", translatedAlt);
    });

    const description = document.querySelector<HTMLMetaElement>('meta[name="description"]');
    const spanishDescription = "Contrata a Cristian Rodríguez, Desarrollador de software Full Stack, para tu próximo proyecto.";
    const englishDescription = "Hire Cristian Rodríguez, a Full Stack software developer, for your next project.";
    if (description) description.content = isEnglish ? englishDescription : spanishDescription;

    document.title = isEnglish
      ? "Cristian Rodríguez's Portfolio - Full Stack Developer"
      : "Portfolio de Cristian Rodríguez - Desarrollador y Programador de software";
    document.documentElement.lang = isEnglish ? "en" : "es";
    if (languageToggle) {
      languageToggle.textContent = isEnglish ? "Versión en español" : "My Portfolio";
      languageToggle.setAttribute("aria-label", isEnglish ? "Cambiar a español" : "Traducir al inglés");
    }
  };

  languageToggle?.addEventListener("click", () => {
    isEnglish = !isEnglish;
    translatePage();
  });
</script>
<style is:global>
  :root {
    color-scheme: dark;
    --page-bg: #050816;
    --page-bg-2: #0f172a;
    --page-bg-3: #111827;
    --surface: rgba(15, 23, 42, 0.72);
    --surface-strong: rgba(15, 23, 42, 0.9);
    --surface-border: rgba(148, 163, 184, 0.18);
    --accent: #7dd3fc;
    --accent-strong: #38bdf8;
    --text-main: #eef2ff;
    --text-soft: #cbd5e1;
  }
  html {
    font-family: "Onest Variable", sans-serif;
    scroll-behavior: smooth;
    background: var(--page-bg);
  }
  body {
    margin: 0;
    color: var(--text-main);
    background:
      radial-gradient(circle at top left, rgba(56, 189, 248, 0.22), transparent 34%),
      radial-gradient(circle at top right, rgba(168, 85, 247, 0.18), transparent 28%),
      radial-gradient(circle at 20% 85%, rgba(14, 165, 233, 0.12), transparent 30%),
      linear-gradient(180deg, var(--page-bg) 0%, var(--page-bg-2) 48%, var(--page-bg-3) 100%);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
    background-attachment: fixed;
  }

  body::before,
  body::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
  }

  body::before {
    background:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 100% 100%, 72px 72px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.36), transparent 85%);
    opacity: 0.25;
  }

  body::after {
    background: radial-gradient(circle at center, transparent 40%, rgba(2, 6, 23, 0.42));
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ::selection {
    background: rgba(56, 189, 248, 0.3);
    color: white;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
