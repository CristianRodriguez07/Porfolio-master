---
import Footer from "../components/Footer.astro";
import GhostFibers from "../components/GhostFibers.astro";
import Header from "../components/Header.astro";
import MotionEnhancements from "../components/MotionEnhancements.astro";
import "@fontsource-variable/onest";

interface Props { title: string; description: string; lang?: "es" | "en"; }
const { description, title, lang = "es" } = Astro.props;
const canonicalUrl = new URL(lang === "en" ? "/en/" : "/", "https://crisrcportfolio.netlify.app");
const socialImage = new URL("/og-process-mining.svg", canonicalUrl);
const structuredData = {
  "@context": "https://schema.org", "@type": "Person", name: "Cristian Rodríguez",
  jobTitle: "Process Mining Consultant", address: { "@type": "PostalAddress", addressLocality: "Madrid", addressCountry: "ES" },
  email: "mailto:cr113022@gmail.com", telephone: "+34 675 648 371", url: canonicalUrl.href,
  sameAs: ["https://www.linkedin.com/in/cristian-alcides-rodr%C3%ADguez-cervantes-a3b705250/", "https://github.com/CristianRodriguez07"],
  knowsAbout: ["Process Mining", "Celonis", "PQL", "SQL", "Python", "Process Intelligence"],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#050816" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href="https://crisrcportfolio.netlify.app/" />
    <link rel="alternate" hreflang="en" href="https://crisrcportfolio.netlify.app/en/" />
    <link rel="alternate" hreflang="x-default" href="https://crisrcportfolio.netlify.app/" />
    <link rel="icon" type="image/svg+xml" href="/cr-logo.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cristian Rodríguez - Process Mining Consultant" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_ES"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <canvas class="ghost-fibers" aria-hidden="true"></canvas>
    <GhostFibers />
    <MotionEnhancements />
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; --page-bg: #050816; --page-bg-2: #0f172a; --page-bg-3: #111827; --text-main: #eef2ff; }
  html { font-family: "Onest Variable", sans-serif; scroll-behavior: smooth; background: var(--page-bg); }
  body { margin: 0; color: var(--text-main); background: linear-gradient(180deg, var(--page-bg) 0%, var(--page-bg-2) 48%, var(--page-bg-3) 100%); display: flex; flex-direction: column; min-height: 100vh; position: relative; overflow-x: hidden; background-attachment: fixed; }
  body > main, body > footer { position: relative; z-index: 1; }
  canvas.ghost-fibers { position: fixed; inset: 0; z-index: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0.98; }
  body::before, body::after { content: ""; position: fixed; inset: 0; pointer-events: none; z-index: -1; }
  body::before { background: linear-gradient(116deg, transparent 0 32%, rgba(56,189,248,.12) 42%, transparent 54%), linear-gradient(244deg, transparent 0 46%, rgba(45,212,191,.1) 56%, transparent 67%), repeating-linear-gradient(90deg, rgba(255,255,255,.035) 0 1px, transparent 1px 72px), repeating-linear-gradient(0deg, rgba(255,255,255,.025) 0 1px, transparent 1px 72px); background-size: 180% 180%, 180% 180%, 72px 72px, 72px 72px; mask-image: linear-gradient(180deg, black, transparent 92%); opacity: .5; animation: ambient-drift 18s ease-in-out infinite alternate; }
  body::after { background: conic-gradient(from 210deg at 50% -10%, transparent 0deg, rgba(14,165,233,.08) 55deg, transparent 115deg), linear-gradient(180deg, transparent 0%, rgba(2,6,23,.18) 60%, rgba(2,6,23,.52) 100%); mix-blend-mode: screen; opacity: .8; animation: ambient-pulse 12s ease-in-out infinite alternate; }
  @keyframes ambient-drift { 0% { background-position: 0% 0%, 100% 20%, 0 0, 0 0; } 100% { background-position: 28% 18%, 72% 44%, 36px 28px, 0 36px; } }
  @keyframes ambient-pulse { 0% { opacity: .55; transform: scale(1); } 100% { opacity: .9; transform: scale(1.04); } }
  a { color: inherit; text-decoration: none; }
  ::selection { background: rgba(56,189,248,.3); color: white; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } body::before, body::after { animation: none; } }
</style>
