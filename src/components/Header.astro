<header class="sticky top-0 z-50 px-4 pt-4" data-header>
  <div
    class="header-shell mx-auto flex w-full max-w-[1120px] items-center justify-between gap-4 rounded-full border border-white/10 bg-slate-950/55 px-4 py-3 shadow-2xl shadow-slate-950/30 backdrop-blur-xl lg:px-6"
  >
    <a href="/" class="flex min-w-0 items-center gap-3">
      <img
        class="size-11 shrink-0 rounded-full border border-white/20 object-cover shadow-lg shadow-cyan-500/10 sm:size-12"
        src="/cr-logo.svg"
        alt="Logo de Cristian Rodríguez"
      />
      <div class="min-w-0">
        <p class="truncate text-xs font-semibold tracking-wide text-white sm:text-sm">Cristian Rodríguez</p>
        <p class="header-subtitle text-xs text-slate-300">Full Stack Developer</p>
      </div>
    </a>
    <nav class="hidden items-center justify-end gap-3 text-sm font-medium text-slate-200 md:flex" aria-label="Navegación principal">
      <a class="nav-link rounded-full border border-white/10 bg-white/5 px-3 py-2.5 text-center transition hover:-translate-y-0.5 hover:border-cyan-300/30 hover:bg-cyan-300/10 sm:shrink-0 sm:px-3.5" href="#inicio" data-section="inicio" aria-current="page">Inicio</a>
      <a class="nav-link rounded-full border border-white/10 bg-white/5 px-3 py-2.5 text-center transition hover:-translate-y-0.5 hover:border-cyan-300/30 hover:bg-cyan-300/10 sm:shrink-0 sm:px-3.5" href="#sobre-mi" data-section="sobre-mi">Sobre mí</a>
      <a class="nav-link rounded-full border border-white/10 bg-white/5 px-3 py-2.5 text-center transition hover:-translate-y-0.5 hover:border-cyan-300/30 hover:bg-cyan-300/10 sm:shrink-0 sm:px-3.5" href="#experiencia" data-section="experiencia">Experiencia</a>
      <a class="nav-link rounded-full border border-white/10 bg-white/5 px-3 py-2.5 text-center transition hover:-translate-y-0.5 hover:border-cyan-300/30 hover:bg-cyan-300/10 sm:shrink-0 sm:px-3.5" href="#formacion" data-section="formacion">Formación</a>
      <a class="nav-link rounded-full border border-white/10 bg-white/5 px-3 py-2.5 text-center transition hover:-translate-y-0.5 hover:border-cyan-300/30 hover:bg-cyan-300/10 sm:shrink-0 sm:px-3.5" href="#certificaciones" data-section="certificaciones">Certificaciones</a>
      <a class="nav-link rounded-full border border-white/10 bg-gradient-to-r from-cyan-400/20 to-sky-500/20 px-3 py-2.5 text-center text-cyan-50 transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:from-cyan-400/30 hover:to-sky-500/30 sm:shrink-0 sm:px-3.5" href="#skills" data-section="skills">Skills</a>
    </nav>
  </div>
</header>

<div class="mobile-bottom-nav fixed inset-x-0 bottom-0 z-50 px-4 pb-[max(1rem,env(safe-area-inset-bottom))] md:hidden">
  <label class="sr-only" for="mobile-section-nav">Ir a la sección</label>
  <div class="mx-auto flex max-w-md items-center gap-3 rounded-2xl border border-white/15 bg-slate-950/90 p-2 shadow-2xl shadow-slate-950/50 backdrop-blur-xl">
    <span class="pl-2 text-xs font-semibold uppercase tracking-[0.18em] text-cyan-100">Secciones</span>
    <select id="mobile-section-nav" class="min-w-0 flex-1 appearance-none rounded-xl border border-white/10 bg-white/10 px-3 py-2.5 text-sm font-medium text-white outline-none transition focus:border-cyan-200/60 focus:ring-2 focus:ring-cyan-300/20">
      <option value="inicio">Inicio</option>
      <option value="sobre-mi">Sobre mí</option>
      <option value="experiencia">Experiencia</option>
      <option value="formacion">Formación</option>
      <option value="certificaciones">Certificaciones</option>
      <option value="skills">Skills</option>
    </select>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const updateHeaderState = () => header?.classList.toggle("is-scrolled", window.scrollY > 24);

  window.addEventListener("scroll", updateHeaderState, { passive: true });
  updateHeaderState();

  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link[data-section]"));
  const mobileSectionNav = document.querySelector<HTMLSelectElement>("#mobile-section-nav");
  const sections = navLinks
    .map((link) => document.getElementById(link.dataset.section ?? ""))
    .filter((section): section is HTMLElement => section !== null);

  const setActiveLink = (sectionId: string) => {
    navLinks.forEach((link) => {
      const isActive = link.dataset.section === sectionId;
      link.classList.toggle("border-cyan-200/40", isActive);
      link.classList.toggle("bg-cyan-300/15", isActive);
      link.classList.toggle("text-cyan-50", isActive);
      if (isActive) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
    if (mobileSectionNav) mobileSectionNav.value = sectionId;
  };

  navLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      if (link.dataset.section === "inicio") {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
      const sectionId = link.dataset.section;
      if (sectionId) setActiveLink(sectionId);
    });
  });

  mobileSectionNav?.addEventListener("change", () => {
    const sectionId = mobileSectionNav.value;
    if (sectionId === "inicio") {
      window.scrollTo({ top: 0, behavior: "smooth" });
    } else {
      document.getElementById(sectionId)?.scrollIntoView({ behavior: "smooth", block: "start" });
    }
    setActiveLink(sectionId);
  });

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      const visibleSection = entries.find((entry) => entry.isIntersecting);
      if (visibleSection) setActiveLink(visibleSection.target.id);
    },
    { rootMargin: "-25% 0px -60%", threshold: 0 },
  );

  sections.forEach((section) => sectionObserver.observe(section));
</script>

<style>
  header {
    transition: padding-top 180ms ease;
  }

  .header-shell {
    transition: gap 180ms ease, padding 180ms ease, border-radius 180ms ease;
  }

  .is-scrolled {
    padding-top: 0.5rem;
  }

  .is-scrolled .header-shell {
    gap: 0.5rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    border-radius: 1rem;
  }

  .is-scrolled .header-subtitle {
    display: none;
  }

  .is-scrolled .header-shell {
    border-radius: 9999px;
  }

  @media (max-width: 767px) {
    :global(body) {
      padding-bottom: 5.5rem;
    }
  }
</style>
