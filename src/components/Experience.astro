---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "2025-Actualidad",
    title: "Process Mining con Celonis - Inetum",
    description:
      "Me especializo en la optimización y analítica de procesos con Celonis, SQL y Python. Trabajo desde la preparación de datos hasta la creación de análisis y soluciones orientadas a mejorar la eficiencia operativa.",
    highlights: [
      "Proyecto para la Generalitat de Catalunya centrado en automatizar y mejorar el análisis de datos de ayudas al alquiler. Mantuve una comunicación directa con el cliente para comprender sus necesidades, recoger sus requisitos y alinear la solución con la visión esperada. Participé en la extracción, transformación y modelado de datos, definí indicadores de seguimiento y desarrollé dashboards en Celonis Studio para analizar el estado del proceso, localizar cuellos de botella e identificar inconsistencias y oportunidades de mejora.",
      "Además, aporté ideas y soluciones en varias POCs (pruebas de concepto), evaluando su viabilidad y trasladando los resultados a posibles automatizaciones y mejoras aplicables a procesos reales.",
    ],
    project: {
      name: "Ayudas al Alquiler - Generalitat Catalunya",
      problem: "Unificar y analizar datos del proceso de ayudas al alquiler para detectar retrasos, inconsistencias y cuellos de botella.",
      contribution: "Contacto directo con el cliente, toma de requisitos, modelado de datos, definición de indicadores y creación de dashboards en Celonis Studio.",
      technologies: "Celonis EMS / Process Intelligence Platform, Studio, PQL, PyCelonis, SQL y Python.",
      result: "Una visión más clara del proceso y de sus puntos críticos, facilitando la priorización de mejoras y posibles automatizaciones.",
    },
    },

  {
    date: "2023-2025",
    title: "Desarrollador de software - Getronics",
    description:
      "Compaginé el desarrollo y mantenimiento de aplicaciones con SpringBoot, Angular y Node.js con el análisis y la optimización de procesos mediante Celonis, SQL y Python. Esta combinación me permitió colaborar con perfiles técnicos y de negocio en distintos proyectos.",
    highlights: [
      "Participé en varias POCs (pruebas de concepto), aportando ideas y soluciones técnicas, evaluando alternativas, preparando demos y validando su viabilidad antes de pasar a fases de desarrollo.",
      "En estas iniciativas colaboré en la identificación de necesidades, la definición de propuestas y la conexión entre los análisis de procesos y posibles soluciones de software.",
    ],
  },
];
---

<ol class="relative border-s border-white/15 pl-4">
  {
    EXPERIENCE.map((experiencie) => (
      <li class="mb-10 ms-2">
        <ExperienceItem {...experiencie} />
      </li>
    ))
  }
</ol>
