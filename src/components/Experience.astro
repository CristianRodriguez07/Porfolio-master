---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "2025-Actualidad",
    title: "Process Mining con Celonis - Inetum",
    description:
      "Me especializo en la optimización y analítica de procesos con Celonis, SQL y Python. Trabajo desde la preparación de datos hasta la creación de análisis y soluciones orientadas a mejorar la eficiencia operativa.",
    project: {
      name: "Ayudas al Alquiler - Generalitat Catalunya",
      problem: "Unificar y analizar datos del proceso de ayudas al alquiler para detectar retrasos, inconsistencias y cuellos de botella.",
      contribution: "Contacto directo con el cliente, toma de requisitos, extracción, transformación y modelado de datos, definición de indicadores y creación de dashboards en Celonis Studio.",
      technologies: "Celonis EMS / Process Intelligence Platform, Celonis Studio, PQL, PyCelonis, SQL y Python.",
      result: "Una visión más clara del proceso y de sus puntos críticos, facilitando la priorización de mejoras y posibles automatizaciones.",
    },
  },

  {
    date: "2023-2025",
    title: "Desarrollador de software - Getronics",
    description:
      "Durante esta etapa combiné el desarrollo y mantenimiento de aplicaciones con el análisis y la optimización de procesos, colaborando con perfiles técnicos y de negocio en distintos proyectos.",
    highlights: [
      "Desarrollé y mantuve aplicaciones, conectando necesidades de negocio con soluciones de software y análisis de procesos.",
      "Participé en varias POCs (pruebas de concepto), aportando ideas y soluciones técnicas, evaluando alternativas, preparando demos y validando su viabilidad antes de pasar a fases de desarrollo.",
      "Tecnologías trabajadas: Spring Boot, Angular, Node.js, Celonis, SQL y Python.",
    ],
  },
];
---

<ol class="relative border-s border-white/15 pl-4">
  {
    EXPERIENCE.map((experiencie) => (
      <li class="mb-10 ms-2">
        <ExperienceItem {...experiencie} />
      </li>
    ))
  }
</ol>
