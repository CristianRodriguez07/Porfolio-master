---
interface Props { lang?: "es" | "en"; }
const { lang = "es" } = Astro.props;
const isEnglish = lang === "en";
const copy = isEnglish ? {
  eyebrow: "Next step", title: "Shall we turn process data into measurable improvement?", body: "If you need someone who can connect business requirements, Celonis analysis and technical execution, I would be happy to talk.", primary: "Let's talk", secondary: "View LinkedIn", availability: "Open to new opportunities · Madrid or remote",
} : {
  eyebrow: "Siguiente paso", title: "¿Convertimos los datos de proceso en una mejora medible?", body: "Si buscas un perfil capaz de conectar requisitos de negocio, análisis en Celonis y ejecución técnica, estaré encantado de hablar.", primary: "Hablemos", secondary: "Ver LinkedIn", availability: "Disponible para nuevas oportunidades · Madrid o remoto",
};
---

<div class="contact-cta relative overflow-hidden rounded-[2rem] border border-cyan-300/30 bg-gradient-to-br from-cyan-400/20 via-slate-950/75 to-emerald-400/10 p-6 shadow-2xl shadow-cyan-950/25 sm:p-8 md:p-10">
  <div class="contact-orb pointer-events-none absolute -right-16 -top-20 size-64 rounded-full bg-cyan-300/15 blur-3xl" aria-hidden="true"></div>
  <div class="relative grid gap-7 lg:grid-cols-[1fr_auto] lg:items-end">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cyan-100/75">{copy.eyebrow}</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl md:text-4xl">{copy.title}</h2>
      <p class="mt-4 max-w-2xl text-base leading-7 text-slate-200 sm:text-lg">{copy.body}</p>
      <p class="mt-4 flex items-center gap-2 text-sm text-cyan-100/75"><span class="h-2 w-2 rounded-full bg-emerald-300 shadow-lg shadow-emerald-300/50"></span>{copy.availability}</p>
    </div>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row lg:flex-col">
      <a href="mailto:cr113022@gmail.com?subject=Oportunidad%20Process%20Mining" class="contact-primary group inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-cyan-300 px-6 py-3 text-sm font-bold text-slate-950 shadow-xl shadow-cyan-500/20 transition hover:-translate-y-1 hover:bg-cyan-200">
        {copy.primary}<svg class="size-4 transition group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a href="https://www.linkedin.com/in/cristian-alcides-rodr%C3%ADguez-cervantes-a3b705250/" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/15 bg-white/[0.06] px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-1 hover:border-cyan-200/35 hover:bg-white/10">{copy.secondary}</a>
    </div>
  </div>
</div>

<style>
  .contact-primary { animation: contact-breathe 3.4s ease-in-out infinite; }
  @keyframes contact-breathe { 50% { box-shadow: 0 18px 42px rgba(34,211,238,.28); } }
  @media (prefers-reduced-motion: reduce) { .contact-primary { animation: none; } }
</style>
