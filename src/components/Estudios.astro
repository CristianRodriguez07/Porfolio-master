---
import ExperienceItem from "./ExperienceItem.astro";
interface Props { lang?: "es" | "en"; }
const { lang = "es" } = Astro.props;
const STUDIES = lang === "en" ? [
  { date: "2024-2026", title: "Postgraduate Program in Web Application Development and Blockchain - Cesur Plaza Elíptica", description: "Completed postgraduate training in web application development and emerging technologies, expanding my software engineering background." },
  { date: "2022-2024", title: "Higher Degree in Multiplatform Application Development - Cesur Plaza Elíptica", description: "Built a foundation in software development, databases, Java, Kotlin, HTML, CSS, MySQL, and Python." },
  { date: "2020-2022", title: "High School Diploma, Technology Sciences - IES Gran Capitán", description: "Focused on mathematics, physics, technology, and programming fundamentals." },
] : [
  { date: "2024-2026", title: "Postgrado en Desarrollo de Aplicaciones Web y Blockchain - Cesur Plaza Elíptica", description: "Formación completada en desarrollo de aplicaciones web y tecnologías emergentes, ampliando mi base de ingeniería de software." },
  { date: "2022-2024", title: "Grado Superior en Desarrollo de Aplicaciones Multiplataforma - Cesur Plaza Elíptica", description: "Base sólida en desarrollo de software, bases de datos, Java, Kotlin, HTML, CSS, MySQL y Python." },
  { date: "2020-2022", title: "Bachillerato de Ciencias Tecnológicas - IES Gran Capitán", description: "Formación centrada en matemáticas, física, tecnología y fundamentos de programación." },
];
---
<ol class="relative border-s border-white/15 pl-4">{STUDIES.map((study) => <li class="mb-10 ms-2"><ExperienceItem {...study} lang={lang} /></li>)}</ol>
