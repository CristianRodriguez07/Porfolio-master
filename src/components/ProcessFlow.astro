---
interface Props { lang?: "es" | "en"; }
const { lang = "es" } = Astro.props;
const isEnglish = lang === "en";
const copy = isEnglish ? {
  eyebrow: "How I create value",
  title: "From raw data to measurable action",
  intro: "Explore each stage of the Process Mining workflow.",
  hint: "Select a stage",
  steps: [
    { title: "Connect", short: "Data", description: "I extract and prepare operational data from the relevant sources, checking quality and process context.", meta: "SQL · Python · PyCelonis" },
    { title: "Model", short: "Process", description: "I build an event log and a reliable data model so that every case and activity can be analysed consistently.", meta: "Data Modeling · Celonis" },
    { title: "Understand", short: "Insights", description: "I translate business questions into KPIs, dashboards and analyses that expose delays, variants and bottlenecks.", meta: "PQL · KPI Design · Studio" },
    { title: "Act", short: "Automation", description: "I turn findings into prioritised decisions and action flows, closing the loop between insight and improvement.", meta: "Action Flows · Value Realization" },
  ],
} : {
  eyebrow: "Cómo genero valor",
  title: "Del dato operativo a la acción medible",
  intro: "Explora cada etapa del flujo de trabajo de Process Mining.",
  hint: "Selecciona una etapa",
  steps: [
    { title: "Conectar", short: "Datos", description: "Extraigo y preparo los datos operativos de las fuentes relevantes, comprobando su calidad y el contexto del proceso.", meta: "SQL · Python · PyCelonis" },
    { title: "Modelar", short: "Proceso", description: "Construyo el event log y un modelo de datos fiable para analizar cada caso y actividad de forma consistente.", meta: "Data Modeling · Celonis" },
    { title: "Entender", short: "Insights", description: "Traduzco las preguntas de negocio en KPIs, dashboards y análisis que revelan retrasos, variantes y cuellos de botella.", meta: "PQL · KPI Design · Studio" },
    { title: "Actuar", short: "Automatización", description: "Convierto los hallazgos en decisiones priorizadas y action flows, cerrando el ciclo entre insight y mejora.", meta: "Action Flows · Value Realization" },
  ],
};
---

<div class="overflow-hidden rounded-[2rem] border border-cyan-300/20 bg-slate-950/50 p-5 shadow-2xl shadow-slate-950/25 backdrop-blur-xl sm:p-7 md:p-8" data-process-flow>
  <div class="max-w-3xl">
    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cyan-200/75">{copy.eyebrow}</p>
    <h2 class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.title}</h2>
    <p class="mt-3 text-base leading-7 text-slate-300">{copy.intro} <span class="text-cyan-100/75">{copy.hint}.</span></p>
  </div>

  <div class="process-track relative mt-7 grid grid-cols-2 gap-3 lg:grid-cols-4" role="tablist" aria-label={copy.title}>
    <span class="process-line absolute hidden h-px bg-white/10 lg:block" aria-hidden="true"><span data-flow-progress></span></span>
    {copy.steps.map((step, index) => (
      <button
        type="button"
        class:list={["process-step group relative z-10 rounded-2xl border px-4 py-4 text-left transition duration-300", { "is-active": index === 0 }]}
        role="tab"
        aria-selected={index === 0 ? "true" : "false"}
        aria-controls={`flow-panel-${lang}-${index}`}
        data-flow-step={index}
      >
        <span class="flex items-center justify-between gap-3">
          <span class="process-index flex size-8 items-center justify-center rounded-full border text-xs font-bold transition">0{index + 1}</span>
          <svg class="size-4 text-cyan-200/60 transition group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
        <span class="mt-4 block text-base font-semibold text-white">{step.title}</span>
        <span class="mt-1 block text-xs uppercase tracking-[0.18em] text-cyan-100/65">{step.short}</span>
      </button>
    ))}
  </div>

  <div class="relative mt-4 min-h-[10.5rem] overflow-hidden rounded-2xl border border-cyan-300/15 bg-gradient-to-br from-cyan-400/10 via-slate-900/70 to-slate-950/80">
    {copy.steps.map((step, index) => (
      <div
        id={`flow-panel-${lang}-${index}`}
        class:list={["flow-panel grid gap-5 p-5 sm:p-6 md:grid-cols-[1fr_auto] md:items-end", { "is-active": index === 0 }]}
        role="tabpanel"
        hidden={index !== 0}
        data-flow-panel={index}
      >
        <div><p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-200">0{index + 1} · {step.title}</p><p class="mt-3 max-w-3xl text-base leading-7 text-slate-200 sm:text-lg">{step.description}</p></div>
        <span class="w-fit rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2 text-xs font-semibold text-cyan-50">{step.meta}</span>
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-process-flow]").forEach((root) => {
    const steps = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-flow-step]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-flow-panel]"));
    const progress = root.querySelector<HTMLElement>("[data-flow-progress]");

    const activate = (index: number, focus = false) => {
      steps.forEach((step, stepIndex) => {
        const active = stepIndex === index;
        step.classList.toggle("is-active", active);
        step.setAttribute("aria-selected", String(active));
        step.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel, panelIndex) => {
        const active = panelIndex === index;
        panel.hidden = !active;
        panel.classList.toggle("is-active", active);
      });
      progress?.style.setProperty("transform", `scaleX(${index / Math.max(steps.length - 1, 1)})`);
      if (focus) steps[index]?.focus();
    };

    steps.forEach((step, index) => {
      step.addEventListener("click", () => activate(index));
      step.addEventListener("keydown", (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : -1;
        activate((index + direction + steps.length) % steps.length, true);
      });
    });
    activate(0);
  });
</script>

<style>
  .process-line { left: 12.5%; right: 12.5%; top: 2rem; }
  .process-line span { display: block; width: 100%; height: 100%; transform: scaleX(0); transform-origin: left; background: linear-gradient(90deg, #22d3ee, #5eead4); box-shadow: 0 0 10px rgba(34,211,238,.6); transition: transform 420ms cubic-bezier(.2,.75,.25,1); }
  .process-step { border-color: rgba(255,255,255,.1); background: rgba(255,255,255,.035); }
  .process-step:hover { border-color: rgba(103,232,249,.24); background: rgba(34,211,238,.07); }
  .process-step.is-active { border-color: rgba(103,232,249,.42); background: rgba(34,211,238,.12); box-shadow: 0 14px 34px rgba(8,145,178,.1); transform: translateY(-2px); }
  .process-index { border-color: rgba(103,232,249,.22); background: rgba(8,47,73,.6); color: rgba(207,250,254,.8); }
  .is-active .process-index { border-color: rgba(165,243,252,.55); background: #67e8f9; color: #082f49; box-shadow: 0 0 18px rgba(34,211,238,.28); }
  .flow-panel[hidden] { display: none; }
  .flow-panel.is-active { animation: flow-panel-in 360ms cubic-bezier(.2,.75,.25,1) both; }
  @keyframes flow-panel-in { from { opacity: 0; transform: translate3d(12px,0,0); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .process-line span, .process-step { transition: none; } .flow-panel.is-active { animation: none; } }
</style>
