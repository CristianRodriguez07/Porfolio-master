---
export interface Props {
  title: string;
  description: string;
  highlights?: string[];
  project?: {
    name: string;
    problem: string;
    contribution: string;
    technologies: string;
    result: string;
  };
  link?: string;
  date: string;
}
const { title, description, highlights = [], project, link, date } = Astro.props;
---

<div
  class="absolute -start-6 mt-1.5 h-3 w-3 rounded-full border border-cyan-200/40 bg-cyan-300 shadow-lg shadow-cyan-500/20"
>
</div>
<time class="mb-1 text-sm font-medium leading-none text-cyan-100/80">
  {date}
</time>
<h3 class="mt-2 text-lg font-semibold text-white">
  {title}
</h3>
<p class="mb-4 text-base font-normal leading-7 text-slate-300 text-pretty">
  {description}
</p>
{highlights.length > 0 && (
  <ul class="mb-4 space-y-2 text-base leading-7 text-cyan-100/90">
    {highlights.map((highlight) => (
      <li class="flex gap-2 rounded-xl border border-cyan-300/20 bg-cyan-400/10 px-3 py-2 text-pretty">
        <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-300" aria-hidden="true"></span>
        <span>{highlight}</span>
      </li>
    ))}
  </ul>
)}
{project && (
  <div class="mb-4 rounded-2xl border border-cyan-300/25 bg-cyan-400/10 p-4 sm:p-5">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-200">Proyecto destacado</p>
    <dl class="mt-4 grid gap-3 text-sm leading-6 sm:grid-cols-2">
      <div>
        <dt class="font-semibold text-cyan-100">Nombre del proyecto</dt>
        <dd class="mt-1 text-slate-200">{project.name}</dd>
      </div>
      <div>
        <dt class="font-semibold text-cyan-100">Problema que resolvía</dt>
        <dd class="mt-1 text-slate-200">{project.problem}</dd>
      </div>
      <div>
        <dt class="font-semibold text-cyan-100">Mi contribución</dt>
        <dd class="mt-1 text-slate-200">{project.contribution}</dd>
      </div>
      <div>
        <dt class="font-semibold text-cyan-100">Tecnologías utilizadas</dt>
        <dd class="mt-1 text-slate-200">{project.technologies}</dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="font-semibold text-cyan-100">Resultado conseguido</dt>
        <dd class="mt-1 text-slate-200">{project.result}</dd>
      </div>
    </dl>
  </div>
)}
{
  link && (
    <a
      href={link}
      class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-white transition hover:-translate-y-0.5 hover:border-cyan-300/30 hover:bg-white/10"
    >
      Learn more{" "}
      <svg
        class="ms-2 h-3 w-3 rtl:rotate-180"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 10"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M1 5h12m0 0L9 1m4 4L9 9"
        />
      </svg>
    </a>
  )
}
