---
import celonisLogo from "./Celonis Logo Vector.svg?raw";

const { class: className, ...imageProps } = Astro.props;
const whiteCelonisLogo = celonisLogo
  .replace("<svg ", '<svg width="100%" height="100%" fill="#ffffff" ')
  .replaceAll('fill="#000000"', 'fill="#ffffff"')
  .replaceAll('fill="#000"', 'fill="#ffffff"')
  .replaceAll('fill="black"', 'fill="#ffffff"');
---

<span
  {...imageProps}
  class={className}
  set:html={whiteCelonisLogo}
  aria-hidden="true"
  style="display:inline-flex;vertical-align:middle;align-items:center;justify-content:center"
></span>
