---
import celonisLogo from "./Celonis Logo Vector.svg";

const { class: className, ...imageProps } = Astro.props;
---

<img
  {...imageProps}
  class={className}
  src={celonisLogo.src}
  alt=""
  aria-hidden="true"
  style="display:inline-block;width:1.25em;height:1.25em;vertical-align:middle;object-fit:contain"
/>
