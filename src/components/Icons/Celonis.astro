---
import celonisLogo from "./Celonis Logo Vector.svg?raw";

const { class: className, ...imageProps } = Astro.props;
const whiteCelonisLogo = celonisLogo.replace("<svg ", '<svg fill="#ffffff" ');
---

<span
  {...imageProps}
  class={className}
  set:html={whiteCelonisLogo}
  aria-hidden="true"
  style="display:inline-block;width:1.6em;height:1.6em;vertical-align:middle;object-fit:contain"
></span>
